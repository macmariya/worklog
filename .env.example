# cp .env.example .env して値を入れる。.env はコミットしない

# db コンテナの初期化
POSTGRES_USER=worklog
POSTGRES_PASSWORD=
POSTGRES_DB=worklog

# アプリの接続先（コンテナ内からは host=db、Mac の npm run dev からは localhost:5433）
DATABASE_URL=postgres://worklog:CHANGE_ME@db:5432/worklog

# ログインの共通パスワード
APP_PASSWORD=
# Cookie 署名鍵（openssl rand -hex 32）
AUTH_SECRET=

# Node は必ず UTC。表示は Asia/Tokyo 固定
TZ=UTC
APP_TZ=Asia/Tokyo

# 公開ポート（任意）
APP_PORT=3100

# 記録を始めた日（任意。月次レポートはこの日より前を分母にも分子にも入れない）
REPORT_START=2026-10-21
